{
  "name": "ielts-assignments",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n frontend,backend \"npm run dev -w frontend\" \"npm run dev -w backend\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "start": "npm run start -w backend",
    "preview": "npm run preview -w frontend"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
